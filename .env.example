# SAMRAT AETHERMIND V3 - Unified Environment Configuration
PROJECT_NAME="SAMRAT AETHERMIND V3"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# CORS Origins
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# PostgreSQL Database (Supabase PostgreSQL / Local)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="aethermind_v3"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/aethermind_v3"

# Vector Database (Qdrant Cloud / Local)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Cache & Task Queue (Upstash Redis / Local)
REDIS_URL="redis://localhost:6379/0"

# Object Storage (Supabase Storage)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="aethermind-assets"

# Multimodal AI Provider API Keys (Future Phase Integrations)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""

# Clerk Authentication (Future Phase)
