# AETHERMIND MULTIMODAL AI — UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE
PROJECT_NAME="AetherMind Multimodal AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Firebase Authentication Config
FIREBASE_API_KEY="your-firebase-api-key-here"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-firebase-app-id"
FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Multimodal AI Provider API Keys
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key-here"

# Database & Cache
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/aethermind_v3"
REDIS_URL="redis://localhost:6379/0"

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"

# Supabase Storage
SUPABASE_URL="https://your-supabase-url.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_STORAGE_BUCKET="aethermind-assets"

# Security Secret Key
SECRET_KEY="your-secret-jwt-key-here"
